From RED: assign Japanese-language runtime identity for the pinned Kanto core

Target upstream:
rh-hideout/pokeemerald-expansion@75b806a3ab57a81ff1eb6179288981f0b3cc3050

The GBA header title/game code/maker code are supplied by RED's build wrapper
instead of patching the upstream Makefile.  This keeps the source patch focused
on values that cannot be supplied safely as make command-line variables.

Keep GAME_VERSION=FIRERED so the expansion selects its supported Kanto/FRLG
runtime and map assets.

--- a/include/constants/global.h
+++ b/include/constants/global.h
@@ -76,7 +76,7 @@
     #define IS_FRLG 0
     #endif
 #endif
-#define GAME_LANGUAGE (LANGUAGE_ENGLISH)
+#define GAME_LANGUAGE (LANGUAGE_JAPANESE)
 
 // party sizes
 #define PARTY_SIZE 6
--- a/src/rom_header_gf.c
+++ b/src/rom_header_gf.c
@@ -99,7 +99,7 @@
 __attribute__((section(".text.header_gf"))) USED static const struct GFRomHeader sGFRomHeader = {
     .version = GAME_VERSION,
     .language = GAME_LANGUAGE,
-    .gameName = "pokemon emerald version",
+    .gameName = "pocket monsters red remake",
